[Unit]
Description=Flask Full Host File Server
After=local-fs.target network.target
Wants=local-fs.target

[Service]
Type=simple
# This unit deliberately runs as root so the authenticated administrator can
# reach every locally mounted filesystem. Keep it accessible only on a trusted
# LAN or VPN and protect the credentials in .env (chmod 600).
User=root
WorkingDirectory=/path/to/file-server
EnvironmentFile=/path/to/file-server/.env
ExecStart=/path/to/file-server/.venv/bin/gunicorn --workers 1 --worker-class gthread --threads 4 --timeout 0 --bind 0.0.0.0:8888 --access-logfile - --error-logfile - server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
