[Unit]
Description=Flask File Server
After=network.target

[Service]
Type=simple
# Replace these two placeholders with the normal Ubuntu account and project path.
User=YOUR_USER
WorkingDirectory=/path/to/file-server
EnvironmentFile=/path/to/file-server/.env
# 0.0.0.0 permits trusted-LAN and Tailscale-interface access. Do not port-forward it.
ExecStart=/path/to/file-server/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:8888 --access-logfile - --error-logfile - server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
