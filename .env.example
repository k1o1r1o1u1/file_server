# Copy to .env on the server, replace every placeholder, and keep it private.
FILESERVER_ENV=production
SECRET_KEY=generate-a-long-random-secret
FILESERVER_USERNAME=admin
FILESERVER_PASSWORD_HASH=generate-a-werkzeug-password-hash
# Absolute path is recommended in systemd; this is the administrator's file tree.
# Use / only with the dedicated full-host service configuration.
FILESERVER_STORAGE_DIR=/path/to/file-server/storage
# Private folders for non-admin accounts. Keep this outside STORAGE_DIR when
# STORAGE_DIR=/, so the app does not create /users on the host.
FILESERVER_USERS_DIR=/path/to/file-server/users
# Set true only when the app is accessed through HTTPS.
FILESERVER_SECURE_COOKIES=false
# Optional: change only if required; permits LAN and Tailscale access by default.
FILESERVER_BIND=0.0.0.0:8888
# 0 disables Gunicorn's worker timeout so large uploads can finish.
FILESERVER_TIMEOUT=0
# One worker with four threads allows browsing while another user uploads.
FILESERVER_THREADS=4
